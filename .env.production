# Production build settings. No secrets here.
#
# Where a deployed site sends submissions. Left unset, the site answers its own
# calls from a store inside the browser: the wizard works, but the film never
# leaves the tab and never reaches anyone's review queue.
#
# Locally .env.local takes precedence over this file, so development keeps
# talking to the dashboard on localhost.
NEXT_PUBLIC_API_BASE_URL=https://weshort-admin.vercel.app/api
